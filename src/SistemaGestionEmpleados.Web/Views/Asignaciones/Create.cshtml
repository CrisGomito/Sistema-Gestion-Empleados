@model AsignacionFormViewModel
@{
    ViewData["Title"] = "Nueva asignación";
}

<div class="max-w-2xl">
    <div class="mb-6">
        <h1 class="font-display text-2xl font-bold tracking-tight text-slate-900">Registrar asignación</h1>
        <p class="mt-1 text-sm text-slate-600">Asigne un empleado a un departamento definiendo su cargo y fecha de inicio.</p>
    </div>

    <form asp-action="Create" method="post" class="bg-white border border-slate-200 rounded-xl p-6 space-y-5">
        <div asp-validation-summary="ModelOnly" class="p-3.5 text-sm text-red-800 bg-red-50 border border-red-200 rounded-lg"></div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
                <label asp-for="Asignacion.EmpleadoId" class="block text-sm font-medium text-slate-700 mb-1.5"></label>
                <select asp-for="Asignacion.EmpleadoId" asp-items="Model.Empleados"
                        class="w-full px-3.5 py-2 text-sm bg-white border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-600">
                    <option value="">Seleccione un empleado...</option>
                </select>
                <span asp-validation-for="Asignacion.EmpleadoId"></span>
            </div>
            <div>
                <label asp-for="Asignacion.DepartamentoId" class="block text-sm font-medium text-slate-700 mb-1.5"></label>
                <select asp-for="Asignacion.DepartamentoId" asp-items="Model.Departamentos"
                        class="w-full px-3.5 py-2 text-sm bg-white border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-600">
                    <option value="">Seleccione un departamento...</option>
                </select>
                <span asp-validation-for="Asignacion.DepartamentoId"></span>
            </div>
        </div>

        <div>
            <label asp-for="Asignacion.Cargo" class="block text-sm font-medium text-slate-700 mb-1.5"></label>
            <input asp-for="Asignacion.Cargo" class="w-full px-3.5 py-2 text-sm border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-600" />
            <span asp-validation-for="Asignacion.Cargo"></span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
                <label asp-for="Asignacion.FechaAsignacion" class="block text-sm font-medium text-slate-700 mb-1.5"></label>
                <input asp-for="Asignacion.FechaAsignacion" type="date" class="w-full px-3.5 py-2 text-sm font-mono border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-600" />
                <span asp-validation-for="Asignacion.FechaAsignacion"></span>
            </div>
            <div>
                <label asp-for="Asignacion.FechaFin" class="block text-sm font-medium text-slate-700 mb-1.5"></label>
                <input asp-for="Asignacion.FechaFin" type="date" class="w-full px-3.5 py-2 text-sm font-mono border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-600" />
                <span asp-validation-for="Asignacion.FechaFin"></span>
            </div>
        </div>

        <div class="flex flex-wrap items-center gap-6 pt-1">
            <label class="inline-flex items-center gap-2 text-sm text-slate-700">
                <input asp-for="Asignacion.EsPrincipal" class="h-4 w-4 rounded border-slate-300 text-blue-700 focus:ring-blue-600" />
                <span>Marcar como departamento principal</span>
            </label>
            <label class="inline-flex items-center gap-2 text-sm text-slate-700">
                <input asp-for="Asignacion.Activa" class="h-4 w-4 rounded border-slate-300 text-blue-700 focus:ring-blue-600" />
                <span>Asignación activa</span>
            </label>
        </div>

        <div>
            <label asp-for="Asignacion.Observaciones" class="block text-sm font-medium text-slate-700 mb-1.5"></label>
            <textarea asp-for="Asignacion.Observaciones" rows="3" class="w-full px-3.5 py-2 text-sm border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-600"></textarea>
            <span asp-validation-for="Asignacion.Observaciones"></span>
        </div>

        <div class="pt-4 border-t border-slate-200 flex items-center justify-end gap-3">
            <a asp-action="Index" class="px-4 py-2 text-sm font-medium text-slate-700 bg-white border border-slate-300 rounded-lg hover:bg-slate-50">
                Cancelar
            </a>
            <button type="submit" class="px-4 py-2 text-sm font-medium text-white bg-blue-700 rounded-lg hover:bg-blue-800">
                Guardar asignación
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
