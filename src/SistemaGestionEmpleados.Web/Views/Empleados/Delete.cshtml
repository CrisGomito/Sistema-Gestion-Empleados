@model EmpleadoDto
@{
    ViewData["Title"] = "Eliminar empleado";
}

<div class="max-w-xl bg-white border border-slate-200 rounded-xl p-6 space-y-5">
    <div>
        <h1 class="font-display text-xl font-bold text-slate-900">Confirmar eliminación</h1>
        <p class="mt-1 text-sm text-slate-600">
            ¿Está seguro de que desea eliminar al empleado <strong>@Model.NombreCompleto</strong>?
        </p>
    </div>

    <dl class="grid grid-cols-2 gap-4 py-4 border-y border-slate-200 text-sm">
        <div>
            <dt class="text-xs text-slate-500">Correo electrónico</dt>
            <dd class="mt-0.5 font-medium text-slate-900">@Model.Email</dd>
        </div>
        <div>
            <dt class="text-xs text-slate-500">Teléfono</dt>
            <dd class="mt-0.5 font-mono text-slate-900">@Model.Telefono</dd>
        </div>
        <div>
            <dt class="text-xs text-slate-500">Asignaciones activas</dt>
            <dd class="mt-0.5 font-mono text-slate-900">@Model.TotalAsignacionesActivas</dd>
        </div>
    </dl>

    <form asp-action="Delete" method="post" class="flex items-center justify-end gap-3">
        <input type="hidden" asp-for="EmpleadoId" />
        <a asp-action="Index" class="px-4 py-2 text-sm font-medium text-slate-700 bg-white border border-slate-300 rounded-lg hover:bg-slate-50">
            Cancelar
        </a>
        <button type="submit" class="px-4 py-2 text-sm font-medium text-white bg-red-600 rounded-lg hover:bg-red-700">
            Eliminar empleado
        </button>
    </form>
</div>
