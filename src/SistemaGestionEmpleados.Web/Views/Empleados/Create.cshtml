@model EmpleadoDto
@{
    ViewData["Title"] = "Nuevo empleado";
}

<div class="max-w-2xl">
    <div class="mb-6">
        <h1 class="font-display text-2xl font-bold tracking-tight text-slate-900">Registrar empleado</h1>
        <p class="mt-1 text-sm text-slate-600">Ingrese la información personal y de contacto del colaborador.</p>
    </div>

    <form asp-action="Create" method="post" class="bg-white border border-slate-200 rounded-xl p-6 space-y-5">
        <div asp-validation-summary="ModelOnly" class="p-3.5 text-sm text-red-800 bg-red-50 border border-red-200 rounded-lg"></div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
                <label asp-for="Nombre" class="block text-sm font-medium text-slate-700 mb-1.5"></label>
                <input asp-for="Nombre" class="w-full px-3.5 py-2 text-sm border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-600" />
                <span asp-validation-for="Nombre"></span>
            </div>
            <div>
                <label asp-for="Apellido" class="block text-sm font-medium text-slate-700 mb-1.5"></label>
                <input asp-for="Apellido" class="w-full px-3.5 py-2 text-sm border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-600" />
                <span asp-validation-for="Apellido"></span>
            </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
                <label asp-for="Email" class="block text-sm font-medium text-slate-700 mb-1.5"></label>
                <input asp-for="Email" type="email" class="w-full px-3.5 py-2 text-sm border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-600" />
                <span asp-validation-for="Email"></span>
            </div>
            <div>
                <label asp-for="Telefono" class="block text-sm font-medium text-slate-700 mb-1.5"></label>
                <input asp-for="Telefono" class="w-full px-3.5 py-2 text-sm font-mono border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-600" />
                <span asp-validation-for="Telefono"></span>
            </div>
        </div>

        <div class="pt-4 border-t border-slate-200 flex items-center justify-end gap-3">
            <a asp-action="Index" class="px-4 py-2 text-sm font-medium text-slate-700 bg-white border border-slate-300 rounded-lg hover:bg-slate-50">
                Cancelar
            </a>
            <button type="submit" class="px-4 py-2 text-sm font-medium text-white bg-blue-700 rounded-lg hover:bg-blue-800">
                Guardar empleado
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
