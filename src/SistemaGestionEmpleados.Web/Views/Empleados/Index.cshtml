@model IReadOnlyList<EmpleadoDto>
@{
    ViewData["Title"] = "Empleados";
    var search = ViewData["Search"]?.ToString();
}

@section HeaderAction {
    <a asp-action="Create" class="inline-flex items-center px-4 py-2 text-sm font-medium text-white bg-blue-700 hover:bg-blue-800 rounded-lg transition-colors whitespace-nowrap">
        Nuevo empleado
    </a>
}

<div class="space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
        <div>
            <h1 class="font-display text-2xl font-bold tracking-tight text-slate-900">Empleados</h1>
            <p class="mt-1 text-sm text-slate-600">Directorio completo de personal, datos de contacto y departamento principal.</p>
        </div>

        <form method="get" asp-action="Index" class="flex items-center gap-2 w-full sm:w-auto">
            <label for="search-empleados" class="sr-only">Buscar empleado</label>
            <input id="search-empleados" type="search" name="search" value="@search"
                   placeholder="Buscar por nombre, correo o teléfono..."
                   class="w-full sm:w-72 px-3.5 py-2 text-sm bg-white border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-600" />
            <button type="submit" class="px-4 py-2 text-sm font-medium text-slate-700 bg-white border border-slate-300 rounded-lg hover:bg-slate-50 whitespace-nowrap">
                Buscar
            </button>
        </form>
    </div>

    <div class="bg-white border border-slate-200 rounded-xl overflow-hidden">
        @if (!Model.Any())
        {
            <div class="p-10 text-center">
                <p class="text-sm font-medium text-slate-900">No se encontraron empleados registrados.</p>
                <a asp-action="Create" class="mt-4 inline-flex px-4 py-2 text-sm font-medium text-white bg-blue-700 rounded-lg hover:bg-blue-800">
                    Registrar empleado
                </a>
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse text-sm">
                    <thead>
                        <tr class="border-b border-slate-200 text-xs text-slate-500 bg-slate-50/70">
                            <th class="py-3 px-6 font-medium">ID</th>
                            <th class="py-3 px-4 font-medium">Empleado</th>
                            <th class="py-3 px-4 font-medium">Correo electrónico</th>
                            <th class="py-3 px-4 font-medium">Teléfono</th>
                            <th class="py-3 px-4 font-medium">Departamento principal</th>
                            <th class="py-3 px-6 font-medium text-right">Acciones</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @foreach (var item in Model)
                        {
                            <tr class="hover:bg-slate-50 transition-colors">
                                <td class="py-3.5 px-6 font-mono text-xs text-slate-500 tabular-nums">@item.EmpleadoId</td>
                                <td class="py-3.5 px-4 font-medium text-slate-900">@item.NombreCompleto</td>
                                <td class="py-3.5 px-4 text-slate-600">@item.Email</td>
                                <td class="py-3.5 px-4 font-mono text-xs text-slate-700 tabular-nums">@item.Telefono</td>
                                <td class="py-3.5 px-4 text-slate-700">
                                    @(item.DepartamentoPrincipal ?? "Sin asignación activa")
                                </td>
                                <td class="py-3.5 px-6 text-right whitespace-nowrap space-x-3 text-xs font-medium">
                                    <a asp-action="Details" asp-route-id="@item.EmpleadoId" class="text-slate-600 hover:text-slate-900">Ver</a>
                                    <a asp-action="Edit" asp-route-id="@item.EmpleadoId" class="text-blue-700 hover:text-blue-900">Editar</a>
                                    <a asp-action="Delete" asp-route-id="@item.EmpleadoId" class="text-red-600 hover:text-red-800">Eliminar</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
